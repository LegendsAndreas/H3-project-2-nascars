{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mqtt": {
    "Host": "127.0.0.1",
    "Port": 1883,
    "UseTls": false,
    "ClientIdPrefix": "game-api",
    "InputTopic": "game/input",
    "StateTopic": "game/state",
    "ReconnectDelaySeconds": 3,
    "MaxPayloadBytes": 4096
  }
}
